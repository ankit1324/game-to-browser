+#ifdef __EMSCRIPTEN__
+	// On high-DPI screens the mouse position is in CSS pixels, but the render scale is in canvas pixels.
+	int window_width, output_width;
+	SDL_GetWindowSize(window_, &window_width, NULL);
+	SDL_GetRendererOutputSize(renderer_, &output_width, NULL);
+	if (window_width > 0) {
+		mouse_x = mouse_x * output_width / window_width;
